{
  "name": "skeleton-server",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "aasenov",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "node --env-file=.env --watch-path ./src --import tsx ./src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit && oxfmt --write && oxlint --fix",
    "test": "node --env-file=.env --import tsx --test",
    "test:main": "node --env-file=.env --import tsx ./src/tests/main.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio",
    "db:push": "npx drizzle-kit push",
    "db:pull": "npx drizzle-kit pull",
    "db:check": "npx drizzle-kit check"
  },
  "dependencies": {
    "@fastify/auth": "~5.1.2",
    "@fastify/compress": "~9.3.0",
    "@fastify/cookie": "~11.1.5",
    "@fastify/cors": "~11.4.1",
    "@fastify/env": "~7.0.1",
    "@fastify/jwt": "~10.2.7",
    "@fastify/multipart": "~10.1.8",
    "@fastify/oauth2": "~8.3.2",
    "@fastify/rate-limit": "~11.2.2",
    "@fastify/schedule": "~7.0.2",
    "@fastify/sse": "~0.6.1",
    "@fastify/static": "~10.1.10",
    "@fastify/swagger": "~9.9.3",
    "@fastify/swagger-ui": "~6.1.3",
    "@fastify/type-provider-typebox": "~6.3.0",
    "@fastify/websocket": "~11.3.7",
    "croner": "~11.0.0",
    "drizzle-orm": "~1.0.0-rc.5",
    "fastify": "~5.12.8",
    "handlebars": "~4.7.10",
    "microdiff": "~1.6.0",
    "nodemailer": "~10.3.1",
    "pg": "~8.23.1",
    "sanitize-html": "~2.18.1",
    "toad-scheduler": "~4.2.0",
    "typebox": "~1.4.5"
  },
  "devDependencies": {
    "@types/node": "~26.6.6",
    "@types/nodemailer": "~8.0.2",
    "@types/pg": "~8.23.1",
    "@types/sanitize-html": "~2.16.2",
    "@types/ws": "~8.18.2",
    "drizzle-kit": "~1.0.0-rc.5",
    "oxfmt": "~0.77.0",
    "oxlint": "~1.92.0",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2"
  }
}
